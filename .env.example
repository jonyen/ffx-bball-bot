SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_BOT_USER_ID=U0000000000
# Comma-separated list of Slack channel IDs. The bot must be a member of every channel.
SLACK_CHANNELS=C0123456789

# Slack user ID DMed when a Lambda hits an unrecoverable error.
FAILURE_DM_USER=U0123456789

# Slack channel ID that CloudWatch alarms are posted to.
ALARM_CHANNEL=C0123456789
